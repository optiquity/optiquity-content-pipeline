          },
          "conditions": [
            {
              "id": "c3000000-0000-4000-8000-000000000002",
              "leftValue": "={{ $json.statusCode }}",
              "rightValue": 200,
              "operator": {
                "type": "number",
                "operation": "equals"
              }
            }
