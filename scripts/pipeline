#!/usr/bin/env bash
# scripts/pipeline — thin operator entrypoint (plan T8): delegates to `python -m pipeline`
# inside the uv-managed project venv. All real behavior lives in the package; this shim
# only resolves the repo root so it works from any cwd. Subcommands land with their owning
# plan steps (e.g. drift-report: step 12; ssot derive-state: step 22).
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

# `invoke` (plan step 32) — the external-actor API (§21): a single JSON object on stdout
# (the n8n-facing shape). It routes straight to the api CLI module so the api layer's entry
# stays self-contained; every other subcommand delegates to `python -m pipeline`
# (pipeline/__main__.py) as before.
if [ "${1:-}" = "invoke" ]; then
  shift
  exec uv run --project "$REPO_ROOT" python -m pipeline.api.invoke "$@"
fi

# `serve` (DR-1 Commit 5a) — the HTTP shim (§21.9): a stateless persistent transport FRONT over
# the same `invoke()` door. Routes straight to the api shim module (its own self-contained entry,
# the sibling of `invoke` above). Tier-A verbs are served synchronously; the Tier-B async door
# lands in a later DR-1 commit. `serve --help` dispatches to the shim's argparse.
if [ "${1:-}" = "serve" ]; then
  shift
  exec uv run --project "$REPO_ROOT" python -m pipeline.api.http_shim "$@"
fi

exec uv run --project "$REPO_ROOT" python -m pipeline "$@"
